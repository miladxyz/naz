# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/alireza-nazari-law

# ── Payload CMS ───────────────────────────────────────────────
# یک رشته تصادفی قوی وارد کنید (حداقل ۳۲ کاراکتر)
PAYLOAD_SECRET=change-this-to-a-very-long-random-secret-string

# ── Next.js ───────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── SMS.ir (احراز هویت با پیامک) ─────────────────────────────
# کلید API از panel.sms.ir → تنظیمات → کلید API
SMSIR_API_KEY=your-smsir-api-key-here
# شناسه عددی قالب کد تأیید از panel.sms.ir → ارسال هوشمند → قالب‌ها
# قالب باید یک پارامتر «Code» داشته باشد
SMSIR_TEMPLATE_ID=your-template-id-here
